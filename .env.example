# Genesis OS — Enterprise Decision Intelligence
# Copy to .env and fill in. With nothing set, the system boots fully in MOCK mode.

# --- Google Cloud (runtime cognition — required for LIVE mode) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-flash-latest
# or, instead of Vertex: GOOGLE_API_KEY=...

# --- Confluent Cloud decision ledger (locked §2.4; system degrades gracefully without it) ---
# CONFLUENT_BOOTSTRAP=pkc-xxxxx.us-central1.gcp.confluent.cloud:9092
# CONFLUENT_API_KEY=...
# CONFLUENT_API_SECRET=...
CONFLUENT_LEDGER_TOPIC=genesis.enterprise.ledger

# --- Preserved stack (defaults match ops/docker-compose.yml) ---
POSTGRES_DSN=postgresql://genesis:genesis@localhost:5436/genesis_enterprise
NATS_URL=nats://localhost:4226
TEMPORAL_ADDRESS=localhost:7236
REDIS_URL=redis://localhost:6383/0
DATAHUB_GMS_URL=http://localhost:8080
MINIO_ENDPOINT=localhost:9020
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Policy engine (Bob-built subsystem) ---
POLICY_DIR=./policy
POLICY_VERSION=latest

# GENESIS_MOCK=1        # force mock mode everywhere
# GENESIS_SITE=local
